{
  "name": "@dmm1/daemon-ui",
  "version": "0.1.2",
  "description": "Dark HUD terminal-style React component library. 57+ components built with Tailwind 4, CVA, and Motion. The shadcn/ui for hackers.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./src/styles/index.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc --emitDeclarationOnly",
    "prepublishOnly": "pnpm build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "tailwindcss",
    "dark-mode",
    "hud",
    "terminal",
    "dashboard",
    "design-system",
    "component-library",
    "cva",
    "motion"
  ],
  "author": {
    "name": "dmm1",
    "email": "github@designbeat.at",
    "url": "https://designbeat.at"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmm1/daemon-ui.git"
  },
  "homepage": "https://github.com/dmm1/daemon-ui",
  "bugs": {
    "url": "https://github.com/dmm1/daemon-ui/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "class-variance-authority": "^0.7.1",
    "tailwind-merge": "^3.0.0",
    "motion": "^12.0.0"
  },
  "devDependencies": {
    "@storybook/react": "^10.5.4",
    "@storybook/react-vite": "^10.5.4",
    "@storybook/addon-a11y": "^10.5.4",
    "storybook": "^10.5.4",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "typescript": "~5.6.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "@storybook/addon-docs": "^10.5.4",
    "prettier": "^3.4.2"
  }
}
